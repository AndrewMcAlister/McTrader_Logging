# Virtual environment: 85 MB, machine-specific, and its Scripts\*.exe shims embed absolute paths.
.venv/

# Runtime output. The service writes its own log here.
logs/

# Generated by an editable install (`pip install -e .`); never source.
*.egg-info/

# Python
__pycache__/
*.py[cod]
build/
dist/

# Test and tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local settings and secrets. This service stores no credentials of its own -- the database
# connection uses Trusted_Connection -- but an override should never be committed by accident.
.env
.env.*
*.local
secrets.json
